# Local development only. Never commit real secrets.
APP_ENV=development
COMMUNITY_CONNECT_SECRET=replace-with-a-long-random-secret
# Optional Google OAuth (set both values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google emails granted manager role
MANAGER_EMAILS=
# Optional Sightengine AI-generated/deepfake screening
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
AI_REVIEW_THRESHOLD=0.65
# Persistent directories (Render blueprint sets these to /var/data paths)
COMMUNITY_CONNECT_DATA_DIR=.
COMMUNITY_CONNECT_UPLOAD_DIR=./static/uploads
